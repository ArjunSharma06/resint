# Secrets never belong in the repo. resint reads API keys from the
# environment only -- see model/openai_compat.py -- so nothing here should
# ever hold one. These lines are a safety net, not the mechanism.
.env
.env.*
*.key
secrets.*

# Recorded model responses. These hold sentences copied verbatim out of the
# papers they were run against, and arXiv's default terms do not permit
# redistribution -- so a --record run must never become a commit. Fixtures
# that ship with the repo are rewritten miniatures, and live in corpus/.
fixtures/
*.sqlite
*.sqlite-wal
*.sqlite-shm
